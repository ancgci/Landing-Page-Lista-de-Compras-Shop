# ================================
# ULTRA-ROBUST .HTACCESS - listadecompras.shop
# ================================

RewriteEngine On
RewriteBase /

# Redireciona www ? non-www
RewriteCond %{HTTP_HOST} ^www\.listadecompras\.shop$ [NC]
RewriteRule ^(.*)$ https://listadecompras.shop/$1 [R=301,L]

# Força HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Bloqueio de arquivos sensíveis
<FilesMatch "(\.htaccess|\.env|\.config|\.sql|\.ini|\.log)">
    Require all denied
</FilesMatch>

# Bloqueio de listagem de diretórios
Options -Indexes

# Cache de recursos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 day"
    ExpiresByType text/xml "access plus 1 day"
</IfModule>

# ================================
# Bot management
# ================================
<IfModule mod_setenvif.c>
    # Exceções (Google SEO, Google Ads, Bing, monitores de uptime)
    SetEnvIfNoCase User-Agent "Googlebot|AdsBot-Google|Mediapartners-Google|Bingbot|UptimeRobot|BetterStack|Pingdom" good_bot

    # Bloqueio de bots ruins e scrapers genéricos
    SetEnvIfNoCase User-Agent "wget|curl|python|libwww-perl|spider|crawler" bad_bot

    Order Allow,Deny
    Allow from env=good_bot
    Deny from env=bad_bot
</IfModule>

# Proteção contra XSS e SQL injection
<IfModule mod_rewrite.c>
    RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} union.*select [NC,OR]
    RewriteCond %{QUERY_STRING} base64_encode.*\( [NC,OR]
    RewriteCond %{QUERY_STRING} (\.\./|\.\.) [NC,OR]
    RewriteCond %{QUERY_STRING} (\;|\||`|\$) [NC]
    RewriteRule ^(.*)$ - [F,L]
</IfModule>

# Proteção para formulários
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_METHOD} POST
    RewriteCond %{QUERY_STRING} (\<|%3C|>|%3E|;|\||`|\$) [NC]
    RewriteRule ^(.*)$ - [F,L]
</IfModule>

# Rate limiting e anti-brute force
<IfModule mod_reqtimeout.c>
    RequestReadTimeout header=10-20,minrate=500 body=10,minrate=500
</IfModule>

<IfModule mod_evasive20.c>
    DOSHashTableSize    3097
    DOSPageCount        2
    DOSSiteCount        50
    DOSPageInterval     1
    DOSSiteInterval     1
    DOSBlockingPeriod   10
</IfModule>

# Redirecionamento de URLs antigas
Redirect 301 /antiga-pagina.html https://listadecompras.shop/nova-pagina.html

# Configuração de páginas de erro personalizadas
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html
ErrorDocument 500 /500.html

# Permite acesso a arquivos essenciais de SEO/Ads
<FilesMatch "^(sitemap\.xml|robots\.txt|ads\.txt|google.*\.html)$">
    Require all granted
</FilesMatch>
